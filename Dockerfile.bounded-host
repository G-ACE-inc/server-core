FROM python:3.13-alpine

RUN apk add --no-cache ca-certificates git

WORKDIR /app
COPY --chmod=644 operations/github-project-bounded-host.json /app/operations/github-project-bounded-host.json
RUN chmod 755 /app/operations
COPY scripts/servercore_bounded_host.py /app/scripts/servercore_bounded_host.py
COPY scripts/gace_internal_delivery_auth.py /app/scripts/gace_internal_delivery_auth.py
COPY --chmod=755 scripts/servercore_bounded_host_receiver.py /app/scripts/servercore_bounded_host_receiver.py

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp

USER 65532:65532
EXPOSE 8789
ENTRYPOINT ["python3", "/app/scripts/servercore_bounded_host_receiver.py"]
CMD ["--host", "0.0.0.0", "--port", "8789"]
