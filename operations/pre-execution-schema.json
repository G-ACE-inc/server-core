{
  "schema_version": "1.5",
  "name": "gace-command-center-dispatch",
  "authority": "docs/G_ACE_WORKSPACE.md",
  "required_fields": [
    "PURPOSE",
    "EXPECTED_RESULT",
    "TARGET_PROJECT",
    "TARGET_RESPONSIBILITY",
    "TARGET_REPOSITORY",
    "MUTATION_REPOSITORIES",
    "READ_ONLY_REPOSITORIES",
    "SERVER_CORE_MUTATION_AUTHORIZED",
    "REQUIRED_SERVER_CORE_AUTHORITY",
    "REQUIRED_PROJECT_AUTHORITY",
    "REUSE_CANDIDATES",
    "VERIFY_PATH",
    "APPROVAL_BOUNDARY",
    "CHANGE_BOUNDARY",
    "CONTEXT_SCOPE",
    "BLOCKER"
  ],
  "rules": {
    "unknown_values_must_not_be_guessed": true,
    "server_core_mutation_requires_explicit_owner_authorization": true,
    "fixed_development_routine_must_not_be_skipped_without_reason": true,
    "target_repository_is_not_every_repository_read": true,
    "read_only_reference_does_not_grant_mutation_permission": true,
    "project_document_updates_stay_with_target_project": true,
    "debugai_reuses_existing_evidence_before_server_ai_research": true
  }
}
