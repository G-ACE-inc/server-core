{
  "schema_version": 2,
  "mode": "audit_only",
  "allow_delete": false,
  "runtime_readback_required": true,
  "roots_are_audit_scope_not_presence_or_ownership_proof": true,
  "state_semantics": {
    "policy_defined": "source_contract_only",
    "audit_source_implemented": "audit_implementation_exists_only",
    "audit_run_pass": "read_only_observation_completed_only",
    "candidate_classified": "candidate_or_preserve_or_unknown_only",
    "cleanup_authorized": "separate_runtime_mutation_permission_required",
    "cleanup_applied": "requires_actual_delete_result_and_disk_delta",
    "recovery_verified": "requires_restore_or_rebuild_verification_when_applicable",
    "audit_pass_implies_cleanup_ready": false
  },
  "roots": [
    {
      "path": "/home/admin1/logs",
      "class": "temporary_operational_state",
      "default_action": "inspect_only"
    },
    {
      "path": "/home/admin1/backups",
      "class": "backup",
      "default_action": "preserve_until_retention_and_restore_policy_verified"
    }
  ],
  "docker": {
    "inspect": true,
    "allow_prune": false,
    "allow_volume_delete": false
  },
  "disk_pressure": {
    "thresholds_status": "UNSET_PENDING_REAL_SERVER_MEASUREMENT"
  },
  "safety": {
    "unknown_owner": "preserve",
    "active_use": "preserve",
    "unshipped_data": "preserve",
    "retry_pending": "preserve",
    "recovery_required": "preserve",
    "active_transaction_or_lock": "preserve",
    "unknown_restore_or_rebuild_path": "preserve"
  }
}
