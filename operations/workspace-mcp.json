{
  "schema_version": "1.0",
  "scope": "workspace-global",
  "consumer": "g-ace-workspace",
  "client": "cursor",
  "servers": {
    "cloudflare-api": {
      "url": "https://mcp.cloudflare.com/mcp",
      "auth": {
        "CLIENT_ID": "8ilRHxRMw6Ntq3dP"
      },
      "authentication": "oauth"
    },
    "huggingface": {
      "url": "https://huggingface.co/mcp",
      "authentication": "oauth_or_client_generated_config"
    },
    "debugai": {
      "command": "/usr/bin/docker",
      "args": ["exec", "-i", "debug-ai-debug-ai-1", "node", "/app/bin/debugai-mcp.mjs"]
    }
  },
  "installation": {
    "target": "~/.cursor/mcp.json",
    "merge": "preserve-existing-servers",
    "collision": "fail-closed-on-runtime-transport-mismatch",
    "preserve_existing_auth_fields": [
      "auth",
      "headers",
      "env"
    ],
    "managed_transport_migrations": {
      "debugai": [{"command": "/home/admin1/projects/debug-ai/bin/debugai-mcp.mjs"}]
    }
  }
}
